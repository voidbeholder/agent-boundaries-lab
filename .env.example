# Скопируйте в .env. Ключ остаётся на локальном сервере.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Для Hugging Face: https://router.huggingface.co/v1
LLM_API_KEY=
# Укажите доступную вам модель с поддержкой tools/tool_calls.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=40
LLM_MAX_OUTPUT_TOKENS=1200
# Необязательно: актуальные тарифы выбранной модели, USD за 1 млн токенов.
# Пусто = стоимость неизвестна; 0 = явно заданный бесплатный тариф.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
